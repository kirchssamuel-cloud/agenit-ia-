# ============================================================
# AGENT PLATFORM — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# ============================================================
#
# 🔁 La plateforme est conçue pour fonctionner en MODE DÉMO sans aucune de
# ces clés (placeholders OK). Dès qu'une clé réelle est branchée, le module
# correspondant bascule automatiquement en mode prod.
#
# ============================================================

# ---- Supabase (DB + auth) -----------------------------------
# 👉 https://supabase.com/dashboard → ton projet → Settings → API
# Copier "Project URL", "anon public", "service_role".
# Sans Supabase, l'app tourne en mode démo (mémoire volatile, pas d'auth).
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ---- Anthropic (cerveau de l'agent + superviseur) -----------
# 👉 https://console.anthropic.com/settings/keys
# Sans cette clé, /api/agent/chat retourne une erreur, /api/agent/demo
# tourne en stub. Le superviseur fail-open (skip validation).
ANTHROPIC_API_KEY=

# ---- OpenAI (embeddings pour la mémoire vectorielle RAG) ----
# 👉 https://platform.openai.com/api-keys
# Modèle utilisé : text-embedding-3-small (1536 dims, ~0.02$ / 1M tokens).
# Sans cette clé, la mémoire fonctionne en mode "souvenirs récents"
# (pas de recherche sémantique).
OPENAI_API_KEY=

# ---- Google OAuth (tool read-gmail-inbox) -------------------
# 👉 https://console.cloud.google.com/apis/credentials
# Créer un OAuth 2.0 Client ID type "Web application".
# Authorized redirect URIs : http://localhost:3000/api/oauth/google/callback
#                           https://<ton-domaine>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ---- Resend (envoi d'emails transactionnels) ----------------
# 👉 https://resend.com/api-keys
# Sans clé, le tool send-email retourne ok=false sans envoyer.
RESEND_API_KEY=

# ---- iCall26 (CRM solaire) ----------------------------------
# En attente de réception API d'iCall26 (demandé 2026-05-04).
# Sans clé, le tool push-icall26 tourne en mock (compte les rows mais
# ne pousse pas).
ICALL26_API_URL=
ICALL26_API_KEY=

# ============================================================
# Flags optionnels
# ============================================================

# Force le mode démo même avec des clés réelles (utile pour pitch).
# DEMO_MODE=true

# Superviseur en mode fail-closed : si la clé Anthropic est absente ou
# si la validation échoue, l'action est REJETÉE (recommandé en prod).
# SUPERVISOR_FAIL_CLOSED=true
