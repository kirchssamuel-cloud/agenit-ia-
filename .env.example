# ============================================================
# AGENT PLATFORM — Variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# ============================================================
#
# 🔁 La plateforme est conçue pour fonctionner en MODE DÉMO sans aucune de
# ces clés (placeholders OK). Dès qu'une clé réelle est branchée, le module
# correspondant bascule automatiquement en mode prod.
#
# ============================================================

# ---- Supabase (DB + auth) -----------------------------------
# 👉 https://supabase.com/dashboard → ton projet → Settings → API
# Copier "Project URL", "anon public", "service_role".
# Sans Supabase, l'app tourne en mode démo (mémoire volatile, pas d'auth).
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# ---- Anthropic (cerveau de l'agent + superviseur) -----------
# 👉 https://console.anthropic.com/settings/keys
# Sans cette clé, /api/agent/chat retourne une erreur, /api/agent/demo
# tourne en stub. Le superviseur fail-open (skip validation).
ANTHROPIC_API_KEY=

# ---- Google Gemini (alternative GRATUITE à Anthropic) -------
# 👉 https://aistudio.google.com/apikey  (pas besoin de carte bleue)
# Free tier (mai 2026) : Gemini 2.5 Flash = 500 req/jour, Flash-Lite =
# 1000 req/jour. Largement suffisant pour démos + MVP avec 1-2 clients.
# Utilisé par /api/agent-gemini-test pour évaluer si Gemini peut
# remplacer Claude Sonnet à coût zéro.
GEMINI_API_KEY=

# ---- OpenAI (embeddings pour la mémoire vectorielle RAG) ----
# 👉 https://platform.openai.com/api-keys
# Modèle utilisé : text-embedding-3-small (1536 dims, ~0.02$ / 1M tokens).
# Sans cette clé, la mémoire fonctionne en mode "souvenirs récents"
# (pas de recherche sémantique).
OPENAI_API_KEY=

# ---- Google OAuth (tool read-gmail-inbox) -------------------
# 👉 https://console.cloud.google.com/apis/credentials
# Créer un OAuth 2.0 Client ID type "Web application".
# Authorized redirect URIs : http://localhost:3000/api/oauth/google/callback
#                           https://<ton-domaine>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ---- Tavily (web search en temps réel pour l'agent) ---------
# 👉 https://tavily.com → Get API Key (gratuit jusqu'à 1000 req/mois)
# Sans cette clé, le tool web-search retourne une erreur indiquant
# que la recherche web n'est pas configurée. L'agent ne pourra alors
# pas répondre aux questions sur des infos en temps réel (météo, news,
# prix actuels, données récentes).
TAVILY_API_KEY=

# ---- Resend (envoi d'emails transactionnels) ----------------
# 👉 https://resend.com/api-keys
# Sans clé, le tool send-email retourne ok=false sans envoyer.
RESEND_API_KEY=

# ---- iCall26 (CRM solaire) ----------------------------------
# En attente de réception API d'iCall26 (demandé 2026-05-04).
# Sans clé, le tool push-icall26 tourne en mock (compte les rows mais
# ne pousse pas).
ICALL26_API_URL=
ICALL26_API_KEY=

# ---- Twilio (pool WhatsApp multi-agents) --------------------
# 👉 https://console.twilio.com/us1/account/keys-credentials/api-keys
# Sans ces clés, l'envoi WhatsApp tourne en mode mock (faux SID,
# pas d'appel réseau) et la vérification de signature des webhooks
# entrants est désactivée. Permet de tester le pipeline /api/webhooks/
# whatsapp end-to-end localement sans compte Twilio.
#
# Pour tester en prod sans facture : utiliser la WhatsApp Sandbox Twilio
# (numéro +14155238886, gratuit, 500 msgs/jour, "join <code>" requis
# côté destinataire). Cf. /admin/whatsapp → bouton "Setup MVP 1-clic".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optionnel : URL exacte du webhook si l'auto-détection (host header
# derrière Vercel) ne fonctionne pas. Format complet :
# https://<ton-domaine>/api/webhooks/whatsapp
TWILIO_WEBHOOK_URL=

# ============================================================
# Flags optionnels
# ============================================================

# 🛑 KILL SWITCH WHATSAPP (par défaut : BLOQUÉ)
# Tant que cette var n'est pas exactement "true", AUCUN message WhatsApp
# ne sera envoyé (ni par les crons, ni par le webhook entrant, ni par
# les server actions). Le code logge un warning et retourne un faux SID.
# Mettre à "true" UNIQUEMENT quand on est sûr de vouloir activer les
# envois (ex: après avoir testé le webhook entrant côté Twilio).
# Remettre à false ou supprimer la var = blocage instantané.
WHATSAPP_SEND_ENABLED=false

# Force le mode démo même avec des clés réelles (utile pour pitch).
# DEMO_MODE=true

# Superviseur en mode fail-closed : si la clé Anthropic est absente ou
# si la validation échoue, l'action est REJETÉE (recommandé en prod).
# SUPERVISOR_FAIL_CLOSED=true
